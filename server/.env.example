JWT_SECRET=dev-secret-key
DB_PATH=./data/asset-manager.db

# 端口说明：后端端口用 API_PORT（默认3001）；容器 Nginx 外部端口用 PORT（默认8092）
# 这两个端口建议在启动脚本中以 -e 参数设置，详见运维手册 8.9

# LDAP 配置（企业环境下启用）
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-bind-password
# 搜索基址：单个DN直接填写；多个DN用 | 分隔（DN内含逗号，不能用逗号分隔），登录时依次查找、同步时合并去重
# 单个: LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
# 多个: LDAP_SEARCH_BASE=ou=dev,ou=users,dc=example,dc=com|ou=ops,ou=users,dc=example,dc=com
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={username})
LDAP_DEFAULT_ROLE=user